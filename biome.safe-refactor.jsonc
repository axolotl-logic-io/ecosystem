// Explicit Safe Refactor metric profile. The default check remains unchanged.
// Run with --only for the three metrics; the task separately runs default
// checks and project type diagnostics. Never use --write or --suppress here.
{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": ["./biome.jsonc"],
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 300,
                "skipBlankLines": false
              }
            }
          },
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 50,
                "skipBlankLines": false,
                "skipIifes": false
              }
            },
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": { "maxAllowedComplexity": 15 }
            }
          }
        }
      }
    }
  ]
}
