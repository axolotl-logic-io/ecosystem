// Keep the root policy. These are the dashboard's Node process
// boundaries; they do not exempt imported code from design or type rules.
{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": "//",
  "overrides": [
    {
      "includes": [
        "config.ts",
        "index.ts",
        "local-files.ts",
        "process-observations.ts",
        "task-runs.ts",
        "monitor/collect.ts",
        "monitor/collector.ts",
        "monitor/connection.ts",
        "test/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          }
        }
      }
    },
    {
      // The collector's entrypoint reads the data root from its environment.
      "includes": ["monitor/collect.ts", "test/system-integration/**"],
      "linter": {
        "rules": {
          "style": { "noProcessEnv": "off" }
        }
      }
    },
    {
      // Pi requires its extension factory to be the default export.
      "includes": ["index.ts"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    }
  ]
}
