{
  "name": "@ecosystem/workflow-dash",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts test/component/*.test.ts",
    "test:database": "node --test --test-concurrency=1 --test-timeout=60000 'test/system-integration/*.test.ts'",
    "collect": "node monitor/collect.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings",
    "check": "npm run typecheck && npm test && npm run lint"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@ecosystem/db": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^24.19.2",
    "typebox": "1.3.27",
    "typescript": "^5"
  }
}
