{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "monitor/*.ts",
    "test/support/*.ts",
    "test/component-integration/*.ts",
    "test/system/*.ts",
    "test/system-integration/*.ts"
  ]
}
