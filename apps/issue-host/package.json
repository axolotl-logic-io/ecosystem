{
  "name": "@ecosystem/issue-host",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "lint": "biome check --error-on-warnings",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm run lint",
    "check:full": "npm run build && npm run check && node --test --test-concurrency=8 --test-timeout=180000 'test/{component,component-integration,system,acceptance}/**/*.test.ts'",
    "test:component": "node --test --test-concurrency=8 --test-timeout=180000 'test/component/**/*.test.ts'",
    "test:component-integration": "node --test --test-concurrency=8 --test-timeout=180000 'test/component-integration/**/*.test.ts'",
    "test:system": "node --test --test-concurrency=8 --test-timeout=180000 'test/system/**/*.test.ts'",
    "test:system-integration": "node --test --test-concurrency=1 --test-timeout=180000 'test/system-integration/**/*.test.ts'",
    "test:acceptance": "node --test --test-concurrency=8 --test-timeout=180000 'test/acceptance/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  },
  "dependencies": {
    "smol-toml": "1.9.0",
    "yaml": "2.9.0",
    "zod": "^4.6.7",
    "@ecosystem/gherkin": "*",
    "@ecosystem/task-framework": "*",
    "@ecosystem/task-runtime": "*",
    "@ecosystem/implement": "*",
    "@ecosystem/fix": "*",
    "@ecosystem/verify": "*",
    "@ecosystem/land": "*"
  }
}
