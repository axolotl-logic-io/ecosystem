// The issue pipeline's Biome config. It extends the root biome.jsonc, which
// holds the lint policy for all of the repo's code (`practices-cover-all-code`
// in the wiki). The pipeline passes it, and `mise //apps/issue-pipeline:check`
// runs it (#223). Globs here resolve from this folder.
{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": "//",
  "files": {
    // dist/ is build.ts's output, rebuilt from src/ on every build and install.
    "includes": ["**", "!AGENTS.md", "!dist"]
  },
  "overrides": [
    // src/workflow.js runs as a function body in the pi-subagents sandbox,
    // which provides `args` and `runs`, after the build's helpers bundle,
    // which defines `workflowModules` (build.ts). This declares those globals
    // for that one file; it turns no rule off.
    {
      "includes": ["src/workflow.js"],
      "javascript": {
        "globals": ["args", "runs", "workflowModules"]
      }
    },
    // The only exception to the policy (`best-practice-over-lint`): the
    // pipeline's CLI entry points, the install, the build it runs and the ops
    // CLI, whose entry is src/ops.ts. Each is a command run from the terminal,
    // so it must read the process (its arguments, environment and stdin), the
    // files and the terminal.
    // The ops CLI's own modules are part of that boundary: they run git, gh
    // and the configured commands, and keep the clones, worktrees, locks and
    // logs on disk (#166), clone-setup among them (#213), as do the ops that
    // keep files themselves: the sweep's reservations and the claim's worktree checks and setup log
    // (#183), the PR and sync ops, which run git in the worktree and write
    // the review diff (#184), and the ops that run git, gh and the configured
    // shell commands: verify, fails-before-fix and ci-status (#185). The pure
    // modules (globs, stops, labels, comments, claims, state, start-state,
    // git-state, and the ops in src/ops/ not listed here) get no exception.
    // The tests and their kits, like the install, run commands and keep
    // files, so they need node:test, node:fs, child_process and process (#219).
    // The stage job (#232) is part of it too: its entry src/job.ts reads its
    // arguments and writes its summary, src/job/launch.ts spawns ops.mjs and
    // pi, src/job/agent-definition.ts reads the installed agent files, and the
    // pi extension src/job/structured-output.ts reads its schema file (#232).
    // src/job/args.ts reads the job's arguments, src/job/rpc.ts spawns pi in RPC mode, src/job/status.ts writes job.json
    // and src/job/control.ts keeps the steer socket and the stop signals
    // (#233). The job's pure modules (raw-results, pool, roles) get no exception.
    {
      "includes": [
        "install.mjs",
        "test/**",
        "build.ts",
        "src/ops.ts",
        "src/pipeline-root.ts",
        "src/process.ts",
        "src/config.ts",
        "src/comment-only.ts",
        "src/locks.ts",
        "src/clone-setup.ts",
        "src/checkouts.ts",
        "src/wiki.ts",
        "src/issue-context.ts",
        "src/ops/sweep.ts",
        "src/ops/claim.ts",
        "src/ops/pr.ts",
        "src/ops/sync.ts",
        "src/ops/verify.ts",
        "src/ops/fails-before-fix.ts",
        "src/ops/ci-status.ts",
        "src/job.ts",
        "src/job/launch.ts",
        "src/job/agent-definition.ts",
        "src/job/structured-output.ts",
        "src/job/args.ts",
        "src/job/rpc.ts",
        "src/job/status.ts",
        "src/job/control.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    // pi loads an extension from its default export, so the stage job's pi
    // extension keeps one (`best-practice-over-lint`: default exports are
    // fine where they are the platform's setup).
    {
      "includes": ["src/job/structured-output.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    // GitHub's REST API names a comment's times in snake_case (`created_at`,
    // `updated_at`). comments.ts declares its comment schema with them, and
    // test/fake-gh.mjs, the fake gh, answers with comments in that wire format
    // (#219).
    {
      "includes": ["src/comments.ts", "test/fake-gh.mjs"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
