// The issue pipeline's Biome config. It extends the root biome.jsonc, which
// holds the lint policy for all of the repo's code (`practices-cover-all-code`
// in docs/decisions/code-and-tests.md). The pipeline passes it, and `mise //apps/issue-pipeline:check`
// runs it (#223). Globs here resolve from this folder.
{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": "//",
  "files": {
    // dist/ is build.ts's output, rebuilt from src/ on every build and install.
    "includes": ["**", "!AGENTS.md", "!dist"]
  },
  "overrides": [
    // The only exception to the policy (`best-practice-over-lint`): the
    // modules at the pipeline's process boundary may read the process (its
    // arguments, environment and stdin), the files and the terminal. They are
    // the install, the build, the caller's job launcher (scripts/) and the
    // tests with their kits; the entries of
    // the four CLIs (ops.ts, job.ts, orchestrate.ts, report.ts) and the shell
    // supervisor; the ops modules that run git, gh and the configured
    // commands or keep the clones, worktrees, locks, logs and stop recovery
    // evidence on disk; the
    // stage job's modules that spawn ops.mjs and pi, keep its checkout,
    // control socket, status and logs, or are pi extensions; and the
    // orchestrator's modules that read its arguments, spawn and check the
    // jobs and keep its log and memory. Every other module, such as the
    // roles, the schedule, the saved state and the protocols, gets none.
    {
      "includes": [
        "install.mjs",
        "test/**",
        "build.ts",
        "scripts/**",
        "src/ops.ts",
        "src/pipeline-root.ts",
        "src/process.ts",
        "src/process-group.ts",
        "src/shell-supervisor.ts",
        "src/config.ts",
        "src/locks.ts",
        "src/execution.ts",
        "src/stop-recovery.ts",
        "src/clone-setup.ts",
        "src/checkouts.ts",
        "src/rebase.ts",
        "src/issue-context.ts",
        "src/ops/claim.ts",
        "src/ops/claim-state.ts",
        "src/ops/pr.ts",
        "src/ops/sync.ts",
        "src/ops/prepare-review.ts",
        "src/ops/verify.ts",
        "src/ops/checks.ts",
        "src/ops/push.ts",
        "src/ops/ci-status.ts",
        "src/job.ts",
        "src/job/launch.ts",
        "src/job/runtime-profile.ts",
        "src/job/ops-process.ts",
        "src/job/agent-definition.ts",
        "src/job/git-review.ts",
        "src/job/git-review-process.ts",
        "src/job/git-review-repository.ts",
        "src/job/structured-output.ts",
        "src/job/args.ts",
        "src/job/prompts.ts",
        "src/job/rpc.ts",
        "src/job/status.ts",
        "src/job/context-log.ts",
        "src/job/run-log.ts",
        "src/job/usage-append.ts",
        "src/job/control.ts",
        "src/job/control-protocol.ts",
        "src/job/pipeline-commit-tool.ts",
        "src/job/checkout.ts",
        "src/job/checkout-close.ts",
        "src/job/code-recovery.ts",
        "src/job/exit-push.ts",
        "src/job/dropped-patch.ts",
        "src/job/teardown.ts",
        "src/orchestrate.ts",
        "src/orchestrator/args.ts",
        "src/orchestrator/snapshot.ts",
        "src/orchestrator/log.ts",
        "src/orchestrator/start-job.ts",
        "src/orchestrator/watchdog-memory.ts",
        "src/orchestrator/rate-limit-backoff.ts",
        "src/report.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    // pi loads an extension from its default export, so the stage job's pi
    // extensions keep one (`best-practice-over-lint`: default exports are
    // fine where they are the platform's setup): structured_output's and
    // pipeline_commit's (#303), and git_review's.
    {
      "includes": [
        "src/job/structured-output.ts",
        "src/job/git-review.ts",
        "src/job/pipeline-commit-tool.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    // GitHub's REST API names a comment's times in snake_case (`created_at`,
    // `updated_at`). comments.ts declares its comment schema with them, and
    // test/fake-gh.mjs, the fake gh, answers with comments in that wire format
    // (#219).
    {
      "includes": ["src/comments.ts", "test/fake-gh.mjs"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
