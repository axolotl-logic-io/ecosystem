index 0000000..86e2b23
--- /dev/null
+++ b/apps/issue-pipeline/test/job-execution-fencing.test.mjs
@@ -0,0 +1,68 @@
+// @ts-check
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { z } from "zod";
+import {
+  IMPLEMENTOR_SESSION,
+  implementReplies,
+  repliesAt,
+} from "./job-fixtures.mjs";
+import { logOf, piStarts, runJob, setUp } from "./job-test-kit.mjs";
+
+const OP = z.looseObject({
+  op: z.string(),
+  sweepId: z.string(),
+  lane: z.string(),
+  state: z.unknown().optional(),
+});
+test("fresh loss of issue ownership refuses the real writer launch", () => {
+  const place = setUp(
+    {
+      ...implementReplies(),
+      "assert-execution": { ok: false, error: "execution ownership lost" },
+    },
+    IMPLEMENTOR_SESSION,
+  );
+  const result = runJob(place, ["--stage", "implement", "--lane", "stable"]);
+  assert.equal(result.status, 1);
+  assert.deepEqual(piStarts(place), []);
+  const calls = z.array(OP).parse(logOf(place, "ops.log"));
+  assert.equal(
+    calls.filter((call) => call.op === "assert-execution").length,
+    1,
+  );
+  assert.equal(
+    calls.filter((call) => call.op === "relinquish-execution").length,
+    0,
+  );
+});
+
+test("an explicit stage mismatch preserves the checkpoint and relinquishes without a writer", () => {
+  const place = setUp(
+    { ...repliesAt("review"), "relinquish-execution": { ok: true } },
+    IMPLEMENTOR_SESSION,
+  );
+  const first = runJob(place, ["--stage", "implement", "--lane", "stable"]);
+  assert.equal(first.status, 0, first.stderr);
+  assert.deepEqual(piStarts(place), []);
+  const calls = z.array(OP).parse(logOf(place, "ops.log"));
+  const claim = calls.find((call) => call.op === "claim");
+  const release = calls.find((call) => call.op === "release");
+  const relinquish = calls.find((call) => call.op === "relinquish-execution");
+  assert.ok(claim && release && relinquish);
+  assert.equal(relinquish.sweepId, claim.sweepId);
+  assert.equal(relinquish.lane, "stable");
+  assert.equal(
+    z.object({ stage: z.string() }).parse(release.state).stage,
+    "review",
+  );
+  const second = runJob(place, ["--stage", "implement", "--lane", "stable"]);
+  assert.equal(second.status, 0, second.stderr);
+  const claims = z
+    .array(OP)
+    .parse(logOf(place, "ops.log"))
+    .filter((call) => call.op === "claim");
+  assert.equal(claims.length, 2);
+  assert.notEqual(claims[0]?.sweepId, claims[1]?.sweepId);
+  assert.deepEqual(piStarts(place), []);
+});
