--- /dev/null
+++ b/apps/issue-pipeline/src/job/invocation.ts
@@ -0,0 +1,68 @@
+// One job's distinct process identity, control channel and op envelope.
+import type { Config } from "../config.ts";
+import { paths } from "../config.ts";
+import type { RunArgs } from "./args.ts";
+import type { Brain } from "./brain.ts";
+import type { JobDirs } from "./checkout.ts";
+import { pushServerOf } from "./commit-push.ts";
+import type { Control } from "./control.ts";
+import { openControl, socketPathOf } from "./control.ts";
+import type { LaunchHooks } from "./launch.ts";
+import type { RunOp } from "./ops-request.ts";
+import { opsRunnerOf } from "./ops-request.ts";
+import { hooksOf } from "./session-hooks.ts";
+import type { JobStatus } from "./status.ts";
+import { openStatus } from "./status.ts";
+
+interface Invocation {
+  identity: { id: string; startedAt: string };
+  status: JobStatus;
+  control: Control;
+  hooks: LaunchHooks;
+  runOp: RunOp;
+}
+async function openInvocation(
+  cfg: Config,
+  args: RunArgs,
+  site: { dirs: JobDirs; brain: Brain },
+): Promise<Invocation> {
+  const { dirs, brain } = site;
+  const { issue, stage } = args;
+  const { root, repo, branch } = dirs;
+  const { execution } = cfg;
+  if (execution === undefined) {
+    throw new Error("execution identity required");
+  }
+  const runDir = paths.runDir(cfg, issue);
+  const id = args.jobId ?? crypto.randomUUID();
+  const identity = { id, startedAt: new Date().toISOString() };
+  const lane = args.lane ?? null;
+  const socket = socketPathOf(runDir);
+  const job = { issue, stage, lane, socket, prompts: brain.pinned };
+  const status = openStatus(runDir, { ...job, ...identity });
+  const control = await openControl(
+    runDir,
+    pushServerOf(cfg, { issue, stage, checkout: repo, branch, id }, status),
+  );
+  const hooks = hooksOf(
+    cfg,
+    args,
+    { status, control },
+    { cwd: root, repo, from: process.env, job: identity },
+  );
+  const frame = {
+    config: args.config,
+    sweepId: execution.instance,
+    lane: execution.lane,
+    checkout: { issue, dir: repo, branch },
+  };
+  return {
+    identity,
+    status,
+    control,
+    hooks,
+    runOp: opsRunnerOf(issue, frame, { hooks, status }),
+  };
+}
+
+export { openInvocation };
