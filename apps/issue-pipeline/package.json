{
  "name": "@ecosystem/issue-pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "lint": "biome check --error-on-warnings",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm run lint && npm run build && node --check install.ts && node scripts/check-built.ts",
    "check:full": "npm run check && node --test --test-concurrency=8 --test-timeout=180000 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  },
  "dependencies": {
    "smol-toml": "1.9.0",
    "yaml": "2.9.0",
    "zod": "^4.6.7"
  }
}
