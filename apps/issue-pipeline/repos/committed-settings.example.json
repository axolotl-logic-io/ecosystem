{
  "repo": "OWNER/REPO",
  "baseBranch": "main",
  "devAccount": "DEVELOPMENT-BOT",
  "landingAccount": "REVIEW-MERGE-BOT",
  "credentialsEnvFile": "/absolute/operator-checkout/project/.env",
  "allowedUsers": ["MAINTAINER"],
  "takeNewWork": true,
  "skipLabels": ["deploy"],
  "models": {
