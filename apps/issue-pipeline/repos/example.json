{
  "repo": "OWNER/REPO",
  "baseBranch": "main",
  "devAccount": "DEVELOPMENT-BOT",
  "landingAccount": "REVIEW-MERGE-BOT",
  "credentialsEnvFile": "/absolute/operator-checkout/project/.env",
  "allowedUsers": ["MAINTAINER"],
  "permissions": { "land": false },
  "resources": { "modelSessions": 1 },
  "skipLabels": ["deploy"],
  "models": {
    "author": "openai/gpt-6.1-sol",
    "developer": "openai/gpt-6.1-sol",
    "reviewer": "openai/gpt-6.1-sol"
  },
  "runtime": {
    "home": null,
    "toolchainEnv": {},
    "providerExtension": "/opt/pipeline/providers/pi-cliproxyapi/index.ts",
    "credentialEnv": ["PIPELINE_MODEL_KEY"],
    "compaction": { "targetTokens": 175000, "keepRecentTokens": 30000 },
    "modelContextWindows": { "openai/gpt-6.1-sol": 272000 }
  },
  "commands": {
    "setup": "npm ci",
    "test": "npm test",
    "lint": "npm run lint",
    "typecheck": "npx tsc --noEmit",
    "teardown": "echo nothing to free"
  },
  "lockfiles": [
    {
      "path": "package-lock.json",
      "regenerate": "npm install --package-lock-only --ignore-scripts"
    }
  ],
  "migrations": {
    "pathGlobs": ["migrations/**"],
    "setup": "docker rm -f pipeline-scratch-db >/dev/null 2>&1; docker run -d --name pipeline-scratch-db -e POSTGRES_PASSWORD=x -p 55432:5432 postgres:16 && sleep 5",
    "up": "DATABASE_URL=postgres://postgres:x@localhost:55432/postgres npm run migrate:up",
    "down": "DATABASE_URL=postgres://postgres:x@localhost:55432/postgres npm run migrate:down"
  },
  "requireCi": true,
  "ciWaitMinutes": 30,
  "landingConfirmation": {
    "deadlineSeconds": 90,
    "backoffSeconds": [1, 2, 4, 8, 10]
  },
  "commandTimeoutMinutes": 20,
  "leaseHours": 3,
  "usageFlags": { "firstContext": 40000, "toolOutputShare": 0.25 }
}
