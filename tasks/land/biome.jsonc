{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": "//",
  "overrides": [
    {
      // GitHub comparison responses use the REST field behind_by.
      "includes": ["src/index.ts", "test/component/task.test.ts"],
      "linter": { "rules": { "style": { "useNamingConvention": "off" } } }
    },
    {
      // Behavior tests use the Node test runner and assertions.
      "includes": ["test/**"],
      "linter": { "rules": { "correctness": { "noNodejsModules": "off" } } }
    }
  ]
}
